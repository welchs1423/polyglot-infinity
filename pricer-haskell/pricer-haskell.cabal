cabal-version: 3.0
name:          pricer-haskell
version:       0.1.0
synopsis:      Black-Scholes pricer via Servant HTTP API
build-type:    Simple

executable pricer-haskell
  main-is:          server.hs
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:      -O2 -Wall -threaded -rtsopts
  build-depends:
      base          >= 4.12  && < 5
    , aeson         >= 2.0   && < 2.3
    , servant       >= 0.19  && < 0.21
    , servant-server >= 0.19 && < 0.21
    , warp          >= 3.3   && < 3.5
    , wai           >= 3.2   && < 3.3
