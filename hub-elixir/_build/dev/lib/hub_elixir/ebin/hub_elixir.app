{application,hub_elixir,
    [{modules,
         ['Elixir.HubElixir.Application','Elixir.HubElixir.Endpoint',
          'Elixir.HubElixir.Plugs.CORS','Elixir.HubElixir.Poller',
          'Elixir.HubElixir.RedisSubscriber','Elixir.HubElixir.Router',
          'Elixir.HubElixir.Router.Helpers',
          'Elixir.HubElixir.StatusController',
          'Elixir.HubElixir.SystemChannel','Elixir.HubElixir.UserSocket']},
     {compile_env,
         [{hub_elixir,['Elixir.HubElixir.Endpoint',code_reloader],error},
          {hub_elixir,['Elixir.HubElixir.Endpoint',debug_errors],error},
          {hub_elixir,['Elixir.HubElixir.Endpoint',force_ssl],error}]},
     {optional_applications,[plug_cowboy]},
     {applications,
         [kernel,stdlib,elixir,logger,phoenix,phoenix_pubsub,bandit,jason,
          httpoison,plug_cowboy,redix]},
     {description,"hub_elixir"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.HubElixir.Application',[]}}]}.
